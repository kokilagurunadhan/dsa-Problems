class Solution(object):
    def largestRectangleArea(self, heights):
        heights.append(0)
        stack=[]
        maxarea=0
        for i in range(len(heights)):
            while stack and heights[stack[-1]]>heights[i]:
                height=heights[stack.pop()]
                if stack:
                    left=stack[-1]
                else:
                    left=-1
                width=i-left-1
                area=width*height
                maxarea=max(maxarea,area)
            stack.append(i)
        return maxarea
        