class Solution(object):
    def nextGreaterElements(self, nums):
       stack=[]
       ans=[-1]*len(nums)
       for i in range(2*len(nums)-1,-1,-1):
        current=nums[i%len(nums)]
        while stack and nums[stack[-1]] <=current:
            stack.pop()
        if stack:
            ans[i%len(nums)]=nums[stack[-1]]
        else:
            ans[i%len(nums)]=-1
        stack.append(i%len(nums))
       return ans
        