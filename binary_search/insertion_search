class Solution(object):
    def searchInsert(self, nums, target):
        flag=False
        l=0
        r=len(nums)-1
        while l<=r:
            mid=(l+r)//2
            if(nums[mid]==target):
                flag=True
                break
            elif(nums[mid]<target):
                l=mid+1
            else:
                r=mid-1
        if(flag):
            return mid
        else:
            return l
            
        
        
