class Solution(object):
    def minSubArrayLen(self, target, nums):
        l=0
        window_sum=0
        ans=float('inf')
        for r in range(len(nums)):
            window_sum+=nums[r]
            while window_sum >= target:
                ans=min(ans,r-l+1)
                window_sum-=nums[l]
                l+=1
        if ans == float('inf'):
            return 0    
        return ans
            

        