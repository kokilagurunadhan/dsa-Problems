class Solution(object):
    def checkInclusion(self, s1, s2):
        
        if len(s1)> len(s2):
            return False
        hm1={}
        hm2={}
        for i in s1:
            hm1[i]=hm1.get(i,0)+1
        for ch in s2[:len(s1)]:
            hm2[ch] = hm2.get(ch, 0) + 1

        if hm1 == hm2:
            return True

        # slide
        for r in range(len(s1), len(s2)):

            hm2[s2[r]] = hm2.get(s2[r], 0) + 1

            left = r - len(s1)

            hm2[s2[left]] -= 1

            if hm2[s2[left]] == 0:
                del hm2[s2[left]]

            if hm1 == hm2:
                return True

        return False