
class MyCircularQueue(object):

    def __init__(self, k):
        self.k=k
        self.q=[0]*k
        self.front=0
        self.rear=-1
        self.c=0
        

    def enQueue(self, value):
        if self.isFull():
            return False
        self.rear=(self.rear+1)%self.k
        self.q[self.rear]=value
        self.c+=1
        return True
       
        

    def deQueue(self):
        if self.isEmpty():
            return False
        self.front=(self.front+1)%self.k
        self.c-=1
        return True
        
        

    def Front(self):
        if self.isEmpty():
            return -1
        else:
            return self.q[self.front]
    def Rear(self):
        if self.isEmpty():
            return -1
        else:
            return self.q[self.rear]
        

    def isEmpty(self):
        return self.c==0
        

    def isFull(self):
        return self.k==self.c
        


